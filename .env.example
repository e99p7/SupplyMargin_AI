# Copy this file to .env. Never commit .env.
SUPPLYMARGIN_ENV=development
SUPPLYMARGIN_APP_URL=http://localhost:8000
SUPPLYMARGIN_CORS_ORIGINS=http://localhost:8000
SUPPLYMARGIN_COOKIE_SECURE=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SUPPLYMARGIN_JWT_SECRET=CHANGE_ME_USE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SUPPLYMARGIN_ACCESS_TOKEN_MINUTES=15
SUPPLYMARGIN_REFRESH_TOKEN_DAYS=30

# Legacy integration endpoints only. Keep empty to disable the legacy key in production.
SUPPLYMARGIN_API_KEY=
SUPPLYMARGIN_ADMIN_API_KEY=

SUPPLYMARGIN_MAX_UPLOAD_MB=100
SUPPLYMARGIN_MODE=shadow
SUPPLYMARGIN_AUTO_PUBLISH_ENABLED=false
SUPPLYMARGIN_LOG_LEVEL=INFO
SUPPLYMARGIN_TRIAL_DAYS=0
SUPPLYMARGIN_BASIC_PLAN_RUB=990
SUPPLYMARGIN_BUSINESS_PLAN_RUB=2990

# YooKassa. Leave empty for local development; checkout will return 503.
SUPPLYMARGIN_YOOKASSA_SHOP_ID=
SUPPLYMARGIN_YOOKASSA_SECRET_KEY=
SUPPLYMARGIN_YOOKASSA_RETURN_URL=https://example.ru/?payment=return

# Production Compose
DOMAIN=example.ru
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
MINIO_ROOT_USER=supplymargin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD_AT_LEAST_16_CHARACTERS

# For Cloud.ru Object Storage instead of built-in MinIO, set these in the
# deployment environment and remove the S3 overrides from production compose.
SUPPLYMARGIN_S3_ENDPOINT_URL=
SUPPLYMARGIN_S3_REGION=ru-1
SUPPLYMARGIN_S3_BUCKET=supplymargin-production
SUPPLYMARGIN_S3_ACCESS_KEY_ID=
SUPPLYMARGIN_S3_SECRET_ACCESS_KEY=
SUPPLYMARGIN_S3_SSE=AES256
